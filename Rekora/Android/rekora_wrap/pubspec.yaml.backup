name: rekora_wrap
description: "Rekora Wrap - Vehicle Wrapping Design & Preview App"
publish_to: 'none'

version: 1.0.0+1

environment:
  sdk: '>=3.0.0 <4.0.0'

dependencies:
  flutter:
    sdk: flutter

  # UI & Navigation
  cupertino_icons: ^1.0.8
  go_router: ^13.0.0
  riverpod: ^2.4.0
  flutter_riverpod: ^2.4.0

  # AWS Authentication (Cognito)
  amplify_flutter: ^2.1.0
  amplify_auth_cognito: ^2.1.0

  # HTTP & API
  http: ^1.1.0
  dio: ^5.3.0
  pretty_dio_logger: ^1.3.0

  # State Management
  provider: ^6.1.0
  get_it: ^7.6.0

  # Local Storage
  shared_preferences: ^2.2.0
  flutter_secure_storage: ^9.0.0

  # Image Processing
  image_picker: ^1.0.0
  camera: ^0.11.0

  # JSON & Serialization
  json_annotation: ^4.8.0

  # Logging & Analytics
  datadog_flutter_plugin: ^3.0.0
  firebase_crashlytics: ^3.3.0

  # Utils
  uuid: ^4.0.0
  intl: ^0.19.0
  connectivity_plus: ^5.0.0


dev_dependencies:
  flutter_test:
    sdk: flutter

  flutter_lints: ^3.0.0
  build_runner: ^2.4.0
  json_serializable: ^6.7.0
  riverpod_generator: ^2.3.0

flutter:
  uses-material-design: true
