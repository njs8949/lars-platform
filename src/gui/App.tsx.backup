                }
              ];

              setWorkspaceSteps((prevSteps) => {
                const updatedSteps = JSON.parse(JSON.stringify(prevSteps));
                updatedSteps[2].status = 'completed';
                updatedSteps[2].agents = [
                  { name: 'Data Processor', status: 'completed', result: '데이터 분석 및 처리 완료' },
                  { name: 'AI Inference', status: 'completed', result: 'AI 모델 추론 완료' },
                  { name: 'Validator', status: 'completed', result: '결과 검증 완료' },
                  { name: 'Formatter', status: 'completed', result: '출력 형식화 완료' }
                ];
                updatedSteps[2].agentMessages = [
                  { agent: 'Data Processor', message: '데이터 전처리 및 특성 추출 시작', timestamp: now3 },
                  { agent: 'AI Inference', message: '언어 모델 추론 실행 중...', timestamp: now3 + 200 },
                  { agent: 'Data Processor', message: '데이터 정제 및 통합 작업 진행 중', timestamp: now3 + 400 },
                  { agent: 'Validator', message: '모델 출력 검증 및 신뢰도 평가 중', timestamp: now3 + 800 },
                  { agent: 'AI Inference', message: '추론 완료 - 신뢰도 95.2%', timestamp: now3 + 1000 },
                  { agent: 'Formatter', message: '결과를 사용자 친화적 형식으로 변환 중', timestamp: now3 + 1200 },
                  { agent: 'Validator', message: '최종 검증 완료 - 모든 기준 충족', timestamp: now3 + 1400 }
