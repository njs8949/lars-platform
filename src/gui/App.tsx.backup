                updatedSteps[2].artifacts = artifacts;
                updatedSteps[3].status = 'processing';
                return updatedSteps;
              });

              // 단계 4: 통합
              setTimeout(() => {
                setWorkspaceSteps((prevSteps) => {
                  const now4 = Date.now();
                  const finalSteps = JSON.parse(JSON.stringify(prevSteps));
                  finalSteps[3].status = 'completed';
                  finalSteps[3].agents = [
                    { name: 'Result Integrator', status: 'completed', result: '모든 결과 통합 및 최적화 완료' }
                  ];
                  finalSteps[3].agentMessages = [
                    { agent: 'Result Integrator', message: '실행 단계 결과 수집 및 통합 시작', timestamp: now4 },
                    { agent: 'Result Integrator', message: '다중 에이전트 출력 결합 및 일관성 검증 중', timestamp: now4 + 200 },
