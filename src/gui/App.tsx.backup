    if (selected && typeof selected === 'string') setProjectPath(selected);
  };

  // 생성된 콘텐츠 자동 저장 (사용자가 위치 선택 가능)
  // 마크다운을 PPTX로 변환
  const markdownToPPTX = (markdown: string): Blob => {
    const pres = new PptxGenJS();
    pres.defineLayout({ name: 'LAYOUT1', width: 10, height: 7.5 });

    // 색상 팔레트
    const colors = [
      { rgb: '4267EA' },    // 보라파랑
      { rgb: 'F093FB' },    // 분홍
      { rgb: 'F5576C' },    // 빨강
      { rgb: '4FACFE' },    // 하늘
      { rgb: '00F2FE' },    // 청록
      { rgb: '43E97B' },    // 초록
      { rgb: '38F9D7' },    // 민트
      { rgb: 'FA709A' },    // 코랄
      { rgb: 'FEE140' },    // 노랑
    ];

    // 슬라이드 파싱
    const slides = markdown.split('---').map(s => s.trim()).filter(s => s);

    slides.forEach((slideText, idx) => {
      const lines = slideText.split('\n').map(l => l.trim()).filter(l => l);
      let title = '';
      let bullets: string[] = [];

      for (const line of lines) {
        if (line.startsWith('#')) {
          title = line.replace(/^#+\s*/, '');
        } else if (line.startsWith('-') || line.startsWith('•') || line.startsWith('*')) {
          bullets.push(line.replace(/^[-•*]\s+/, ''));
        } else if (title === '' && line) {
          title = line;
        } else if (line && title !== '') {
          bullets.push(line);
        }
      }

      const slide = pres.addSlide();
      const bgColor = colors[idx % colors.length];
      slide.background = bgColor;

      // 제목
      slide.addText(title, {
        x: 0.5,
        y: 0.8,
        w: 9,
        h: 1.2,
        fontSize: 48,
        bold: true,
        color: 'FFFFFF',
        align: 'left',
      });

      // 컨텐츠
      const bulletText = bullets.map((b, i) => ({
        text: b,
        options: { fontSize: 28, color: 'FFFFFF' },
      }));

      slide.addText(
        bulletText.length > 0
          ? bulletText
          : [{ text: '', options: { fontSize: 28, color: 'FFFFFF' } }],
        {
          x: 1,
          y: 2.3,
          w: 8,
          h: 4.5,
          fontSize: 28,
          color: 'FFFFFF',
          valign: 'top',
        }
      );
    });

    // Blob으로 변환
    return pres.write({ outputType: 'blob' }) as Blob;
  };

  // 마크다운을 슬라이드 배열로 파싱
  const parseMarkdownToSlides = (markdown: string): any[] => {
    const slides: any[] = [];
    const slideTexts = markdown.split('---').map(s => s.trim()).filter(s => s);

    slideTexts.forEach((slideText, idx) => {
      const lines = slideText.split('\n').map(l => l.trim()).filter(l => l);

      let title = '';
      let content = '';
      let bullets: string[] = [];
      let visual: string | undefined;

      for (const line of lines) {
        if (line.startsWith('# 슬라이드')) {
          // "# 슬라이드 1: 제목" 형식 파싱
          title = line.replace(/^#+\s*슬라이드\s*\d+:\s*/, '');
        } else if (line.startsWith('-')) {
          bullets.push(line.replace(/^-\s*/, ''));
        } else if (line.startsWith('[시각화:')) {
          visual = line.replace(/^\[시각화:\s*/, '').replace(/\]$/, '');
        } else if (!line.startsWith('*') && line) {
          if (!content) {
            content = line;
          }
        }
      }

      slides.push({
        order: idx + 1,
        title: title || `슬라이드 ${idx + 1}`,
        content: content,
        bullets: bullets.length > 0 ? bullets : [],
        visual: visual
      });
    });

    return slides;
  };

  // 마크다운 슬라이드를 HTML로 변환
  const markdownToHTMLSlides = (markdown: string): string => {
    const slides = markdown.split('---').map(s => s.trim()).filter(s => s);

    const slideHtmls = slides.map((slide, idx) => {
      const lines = slide.split('\n').map(l => l.trim()).filter(l => l);
      let title = '';
      let content = '';

      // 첫 줄이 제목 (# 또는 ## 형식)
      if (lines[0]?.startsWith('#')) {
        title = lines[0].replace(/^#+\s*/, '');
        content = lines.slice(1).join('');
      } else {
        content = lines.join('');
      }

      // 글릿 포인트 처리
      const bulletPoints = content.match(/^[-•]\s+.+$/gm) || [];
      const bulletHTML = bulletPoints.map(b => `<li>${b.replace(/^[-•]\s+/, '')}</li>`).join('');

      return `
        <div class="slide ${idx === 0 ? 'active' : ''}">
          ${title ? `<h1>${title}</h1>` : ''}
          ${bulletHTML ? `<ul>${bulletHTML}</ul>` : `<p>${content}</p>`}
        </div>
      `;
    }).join('');

    return `<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>LARS 프레젠테이션</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body { width: 100%; height: 100%; overflow: hidden; }
    body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background: #1a1a1a; }

    .slides-container { width: 100%; height: 100%; position: relative; }

    .slide {
      display: none;
      width: 100%;
      height: 100%;
      padding: 80px 100px;
      position: absolute;
      top: 0;
      left: 0;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: white;
      flex-direction: column;
      justify-content: center;
      font-size: 28px;
      line-height: 1.6;
      overflow: auto;
    }

    .slide.active { display: flex; }

    .slide:nth-child(2n) { background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); }
    .slide:nth-child(3n) { background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); }
    .slide:nth-child(4n) { background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%); }
    .slide:nth-child(5n) { background: linear-gradient(135deg, #fa709a 0%, #fee140 100%); }

    .slide h1 {
      font-size: 64px;
      margin-bottom: 60px;
      font-weight: bold;
      text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
    }

    .slide ul {
      list-style: none;
      margin: 30px 0;
    }

    .slide li {
      margin: 25px 0;
      padding-left: 50px;
      position: relative;
      font-size: 32px;
    }

    .slide li:before {
      content: "▸";
      position: absolute;
      left: 0;
      font-size: 40px;
    }

    .slide p {
      font-size: 32px;
      line-height: 1.8;
    }

    .controls {
      position: fixed;
      bottom: 30px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      gap: 20px;
      z-index: 1000;
    }

    .btn {
      background: rgba(255,255,255,0.3);
      color: white;
      border: 2px solid white;
      padding: 12px 24px;
      font-size: 16px;
      cursor: pointer;
      border-radius: 8px;
      transition: all 0.3s;
      backdrop-filter: blur(10px);
    }

    .btn:hover {
      background: rgba(255,255,255,0.5);
      transform: scale(1.05);
    }

    .slide-counter {
      position: fixed;
      top: 30px;
      right: 30px;
      background: rgba(255,255,255,0.3);
      color: white;
      padding: 12px 20px;
      border-radius: 8px;
      font-size: 18px;
      backdrop-filter: blur(10px);
      z-index: 1000;
    }
  </style>
</head>
<body>
  <div class="slides-container">
    ${slideHtmls}
  </div>

  <div class="slide-counter">
    <span id="current">1</span> / <span id="total">${slides.length}</span>
  </div>

  <div class="controls">
    <button class="btn" onclick="prevSlide()">← 이전</button>
    <button class="btn" onclick="nextSlide()">다음 →</button>
  </div>

  <script>
    let currentSlide = 0;
    const totalSlides = document.querySelectorAll('.slide').length;
    document.getElementById('total').textContent = totalSlides;

    function showSlide(n) {
      const slides = document.querySelectorAll('.slide');
      if (n >= slides.length) currentSlide = 0;
      if (n < 0) currentSlide = slides.length - 1;
      slides.forEach(s => s.classList.remove('active'));
      slides[currentSlide].classList.add('active');
      document.getElementById('current').textContent = currentSlide + 1;
    }

    function nextSlide() {
      currentSlide++;
      showSlide(currentSlide);
    }

    function prevSlide() {
      currentSlide--;
      showSlide(currentSlide);
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === ' ') {
        e.preventDefault();
        nextSlide();
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        prevSlide();
      }
    });

    showSlide(0);
  </script>
</body>
</html>`;
  };

  const saveGeneratedContent = async (content: string, type: string, userMessage: string) => {
    try {
      const timestamp = new Date().toISOString().replace(/[:.]/g, '-').slice(0, -5);
      let fileName = '';
      let fileExtension = '';
      let finalContent = content;

      switch (type) {
        case 'document':
          fileName = `문서_${timestamp}`;
          fileExtension = '.md';
          break;
        case 'code':
          fileName = `코드_${timestamp}`;
          fileExtension = '.py'; // 기본값
          // 언어 감지
          if (userMessage.includes('javascript') || userMessage.includes('js')) fileExtension = '.js';
          else if (userMessage.includes('html')) fileExtension = '.html';
          else if (userMessage.includes('css')) fileExtension = '.css';
          else if (userMessage.includes('typescript') || userMessage.includes('ts')) fileExtension = '.ts';
          break;
        case 'presentation':
          // 프레젠테이션: HTML과 PPTX 둘 다 생성
          fileName = `프레젠테이션_${timestamp}`;

          // 사용자에게 포맷 선택 묻기
          const formatChoice = confirm(
            'PPTX 파일로 저장하시겠습니까?\n\n' +
            '[확인] PPTX (PowerPoint)\n' +
            '[취소] HTML (브라우저에서 보기)'
          );

          if (formatChoice) {
            // PPTX 생성 및 다운로드
            const pptxBlob = markdownToPPTX(content);
            const url = URL.createObjectURL(pptxBlob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `${fileName}.pptx`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
            alert(`프레젠테이션이 다운로드되었습니다: ${fileName}.pptx`);
            return;  // 파일 저장 함수 종료
          } else {
            // HTML 생성
            fileExtension = '.html';
            finalContent = markdownToHTMLSlides(content);
          }
          break;
        case 'analysis':
          fileName = `분석_${timestamp}`;
          fileExtension = '.json';
          break;
        default:
          return;
      }

      const fullFileName = `${fileName}${fileExtension}`;

      // Tauri 파일 시스템 API로 저장
      if (isTauri) {
        try {
          // 사용자가 저장 위치 선택
          const selectedPath = await invoke<string | null>('save_file_dialog', {
            suggestedName: fullFileName
          });

          if (selectedPath) {
            // 선택된 위치에 파일 저장
            await invoke('save_file_to_location', {
              path: selectedPath,
              content: finalContent
            });
            console.log(`[SAVED] ${selectedPath}`);
            alert(`파일이 저장되었습니다:\n${selectedPath}`);
          } else {
            console.log('[INFO] 저장 위치 선택 취소됨');
          }
        } catch (e) {
          console.error('[ERROR] 파일 저장 실패:', e);
          // 폴백: 기본 위치에 저장
          try {
            const dirPath = `${process.env.HOME}/.lars/generated`;
            await invoke('create_file', {
              path: `${dirPath}/${fullFileName}`,
              content: finalContent
            });
            console.log(`[SAVED] ${fullFileName} (기본 위치)`);
          } catch (fallbackErr) {
            console.error('[ERROR] 기본 위치에도 저장 실패:', fallbackErr);
          }
        }
      }
    } catch (error) {
      console.error('[ERROR] 파일 저장 실패:', error);
    }
  };

  const handleSendMessage = async (text: string) => {
    if (!text.trim()) return;
    setInput(text);
    // 짧은 딜레이 후 handleCommand 실행
    setTimeout(() => {
      handleCommand();
    }, 100);
  };

  // 웹 검색 수행 헬퍼 함수
  const performWebSearch = async (query: string): Promise<{ text: string; sources: any[] }> => {
    try {
      console.log('[WEB-SEARCH] 검색 시작:', query);
      const apiUrl = import.meta.env.VITE_API_URL || 'http://localhost:8000/api';

      const response = await fetch(`${apiUrl}/search/web?query=${encodeURIComponent(query)}&limit=5`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ query, limit: 5 })
      });

      if (!response.ok) {
        console.warn('[WEB-SEARCH] 검색 실패:', response.status);
        return { text: '', sources: [] };
      }

      const data = await response.json();

      if (data.results && data.results.length > 0) {
        // 검색 결과 필터링 - 관련성 낮은 결과 제거
        const keywordTokens = query.toLowerCase().split(' ').filter(t => t.length > 2);
        const filteredResults = data.results.filter((result: any) => {
          const title = (result.title || '').toLowerCase();
          const snippet = (result.snippet || '').toLowerCase();
          // 최소 2개 이상의 키워드가 제목이나 요약에 포함되어야 함
          const matchCount = keywordTokens.filter(k =>
            title.includes(k) || snippet.includes(k)
          ).length;
          return matchCount >= Math.max(1, Math.floor(keywordTokens.length / 2));
        });

        if (filteredResults.length > 0) {
          // 검색 결과를 프롬프트 형식으로 변환 (간결한 형식)
          const searchContext = filteredResults.map((result: any, idx: number) =>
            `${idx + 1}. ${result.title}\n   ${result.snippet}`
          ).join('\n\n');

          console.log('[WEB-SEARCH] ✅ 검색 완료:', filteredResults.length, '개 결과 (필터링 전:', data.results.length, ')');

          // 출처 정보는 SourceCitations 컴포넌트에서 표시
          return {
            text: `\n\n[웹 검색 결과]\n${searchContext}`,
            sources: filteredResults
          };
        } else {
          console.log('[WEB-SEARCH] 관련 결과 없음 (필터링 후)');
        }
      }

      console.log('[WEB-SEARCH] 검색 결과 없음');
      return { text: '', sources: [] };
    } catch (err) {
      console.error('[WEB-SEARCH] 오류:', err);
      return { text: '', sources: [] };
    }
  };

  const handleCommand = async () => {
    console.log('🔵 [DEBUG] handleCommand 호출됨');
    console.log('🔵 [DEBUG] input:', input);
    console.log('🔵 [DEBUG] attachedFiles:', attachedFiles.length);

    if (!input.trim() && attachedFiles.length === 0) {
      console.log('🔵 [DEBUG] 입력값 없음 - 함수 종료');
      return;
    }

    console.log('🔵 [DEBUG] 입력값 확인됨 - 처리 시작');
    setStatus('ANALYZING');
    setResponse('');
    setCurrentTokens({ input: 0, output: 0, total: 0 });
    let fullContent = '';

    try {
      const userMessage = input.trim();
      const fileContext = attachedFiles.map(f => `@${f.path}`).join(' ');
      const fullPrompt = `${fileContext} ${userMessage}`.trim();

      // 모델별 처리 로직
      console.log(`🤖 [MODEL] 현재 모델: ${activeModel}`);

      // LARS-Native: 빠른 코딩 & 고속 구현
      const isNativeOptimized = activeModel === 'LARS-Native' &&
        (userMessage.includes('코드') || userMessage.includes('함수') || userMessage.includes('버그'));

      // LARS-Cosmos: 깊은 분석 & 아키텍처
      const isCosmosAnalysis = activeModel === 'LARS-Cosmos' &&
        (userMessage.includes('분석') || userMessage.includes('아키텍처') || userMessage.includes('설계'));

      // LARS-Prime: 보안 & 논리 검증
      const isPrimeSecure = activeModel === 'LARS-Prime' &&
        (userMessage.includes('보안') || userMessage.includes('검증') || userMessage.includes('감사'));

      // Aivora: 감정 AI 분석
      const isAivoraEmotion = activeModel === 'Aivora' &&
        (userMessage.includes('감정') || userMessage.includes('분석') || userMessage.includes('상담'));

      // Rekora: 3D 설계 & 이미지 생성
      const isRekoraDesign = activeModel === 'Rekora' &&
        (userMessage.includes('이미지') || userMessage.includes('3D') || userMessage.includes('디자인'));

      // Synzora: 데이터 그래프 & 네트워크
      const isSynzoraGraph = activeModel === 'Synzora' &&
        (userMessage.includes('그래프') || userMessage.includes('네트워크') || userMessage.includes('관계'));

      // 모델 특화 정보 추가
      let modelContext = '';
      if (isNativeOptimized) {
        modelContext = '\n[모델 모드: LARS-Native]\n⚡ 고속 실행 모드 활성화 - 코딩 최적화됨';
      } else if (isCosmosAnalysis) {
        modelContext = '\n[모델 모드: LARS-Cosmos]\n🌌 깊은 분석 모드 - 맥락 강화됨';
      } else if (isPrimeSecure) {
        modelContext = '\n[모델 모드: LARS-Prime]\n🔒 보안 검증 모드 - 무결점 추론';
      } else if (isAivoraEmotion) {
        modelContext = '\n[모델 모드: Aivora]\n❤️ 감정 AI 모드 - 정서 지능 활성화';
      } else if (isRekoraDesign) {
        modelContext = '\n[모델 모드: Rekora]\n🎨 3D 설계 모드 - 비주얼 생성 준비';
      } else if (isSynzoraGraph) {
        modelContext = '\n[모델 모드: Synzora]\n📊 그래프 분석 모드 - 네트워크 시각화';
      }

      // 🎁 프레젠테이션 요청 감지 (직접 처리)
      const isPresentationRequest = userMessage.includes('프레젠테이션') ||
                                    userMessage.includes('프리젠테이션') ||
                                    userMessage.includes('발표') ||
                                    userMessage.includes('슬라이드') ||
                                    userMessage.includes('프레젠');

      console.log(`[PRESENTATION] 메시지: "${userMessage}"`);
      console.log(`[PRESENTATION] 감지 여부: ${isPresentationRequest}`);

      if (isPresentationRequest) {
        console.log(`[PRESENTATION] 🎬 프레젠테이션 생성 요청 감지!`);

        try {
          setResponse(`⏳ 프레젠테이션 생성 중...\n\n이 과정은 약 30초 소요됩니다.`);

          // 첨부된 파일 내용 읽기
          let fileContent = '';
          if (attachedFiles.length > 0) {
            console.log(`[PRESENTATION] 📎 첨부 파일 ${attachedFiles.length}개 발견`);
            for (const file of attachedFiles) {
              try {
                const result = await invoke<string>('execute_terminal_command', { command: `cat "${file.path}"` });
                fileContent += `\n\n=== ${file.name} ===\n${result}`;
              } catch (err) {
                console.warn(`[PRESENTATION] 파일 읽기 실패: ${file.name}`, err);
              }
            }
          }

          // 직접 프레젠테이션 API 호출
          const presResponse = await fetch('http://127.0.0.1:8000/api/presentation/generate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              topic: userMessage,
              audience: 'investor',
              num_slides: 10,
              file_content: fileContent,
              use_file_context: fileContent.length > 0
            }),
            timeout: 120000
          });

          if (presResponse.ok) {
            const presResult = await presResponse.json();

            if (presResult.success && presResult.pptx_base64) {
              console.log(`[PRESENTATION] ✅ PPTX 생성 완료!`);
              console.log(`[PRESENTATION] 슬라이드: ${presResult.slides_count}개`);

              // Base64 → Blob 변환 (비동기로 처리)
              setResponse(`📥 파일 준비 중...\n\n📊 ${presResult.slides_count}개 슬라이드`);

              // 비동기로 처리해서 UI 업데이트
              setTimeout(() => {
                try {
                  // 더 효율적인 방식: Uint8Array 직접 사용
                  const binaryString = atob(presResult.pptx_base64);
                  const len = binaryString.length;
                  const bytes = new Uint8Array(len);

                  for (let i = 0; i < len; i++) {
                    bytes[i] = binaryString.charCodeAt(i);
                  }

                  const pptxBlob = new Blob([bytes], {
                    type: 'application/vnd.openxmlformats-officedocument.presentationml.presentation'
                  });

                  const url = URL.createObjectURL(pptxBlob);
                  const downloadLink = document.createElement('a');
                  downloadLink.href = url;
                  downloadLink.download = presResult.filename || `presentation_${Date.now()}.pptx`;
                  document.body.appendChild(downloadLink);
                  downloadLink.click();
                  document.body.removeChild(downloadLink);
                  URL.revokeObjectURL(url);

                  setResponse(`✅ 완료!\n\n📊 ${presResult.slides_count}개 슬라이드\n📁 파일이 다운로드되었습니다\n\n회의/미팅에서 바로 사용할 수 있습니다!`);
                  setGenerationType('presentation');
                  setStatus('IDLE');
                  setInput('');
                } catch (downloadErr) {
                  console.error('[PRESENTATION] 다운로드 에러:', downloadErr);
                  setResponse(`❌ 다운로드 실패: ${(downloadErr as any).message}`);
                  setStatus('IDLE');
                }
              }, 100);
            }
          }

          setResponse('❌ 프레젠테이션 생성 실패');
          setStatus('IDLE');
          return;

        } catch (presErr) {
          console.error('[PRESENTATION] 에러:', presErr);
          setResponse(`❌ 프레젠테이션 생성 실패: ${(presErr as any).message}`);
          setStatus('IDLE');
          return;
        }
      }

      // 🎯 간단한 방식: 직접 AI 에이전트 호출 (파일 생성 안 함)
      console.log(`[CHAT] 💬 사용자 메시지: "${userMessage}"`);
      console.log(`[CHAT] 생성 모드: ${generationMode}`);

      try {
        const apiUrl = import.meta.env.VITE_API_URL || 'http://localhost:8000/api';

        if (generationMode === 'workspace') {
          // Workspace 모드: 단계별 처리
          console.log('[WORKSPACE] 🚀 Workspace 모드로 처리 시작');
          setResponse('');

          const steps = [
            { step: 1, name: language === 'ko' ? '분석' : 'Analyze', status: 'processing', agents: [] },
            { step: 2, name: language === 'ko' ? '계획' : 'Plan', status: 'pending', agents: [] },
            { step: 3, name: language === 'ko' ? '실행' : 'Execute', status: 'pending', agents: [] },
            { step: 4, name: language === 'ko' ? '통합' : 'Integrate', status: 'pending', agents: [] }
          ];

          setWorkspaceSteps(steps);

          // 단계 1: 분석
          setTimeout(() => {
            setWorkspaceSteps((prevSteps) => {
              const now = Date.now();
              const updatedSteps = JSON.parse(JSON.stringify(prevSteps));
              updatedSteps[0].status = 'completed';
              updatedSteps[0].agents = [
                { name: 'Context Analyzer', status: 'completed', result: `사용자 입력 분석 완료: "${userMessage.substring(0, 50)}..."` }
              ];
              updatedSteps[0].agentMessages = [
                { agent: 'Context Analyzer', message: '사용자 질문 수신 및 초기 분석 시작...', timestamp: now },
                { agent: 'Context Analyzer', message: `질문 주제 분석: ${userMessage.substring(0, 40)}...`, timestamp: now + 100 },
                { agent: 'Context Analyzer', message: '핵심 키워드 추출 및 컨텍스트 파악 완료', timestamp: now + 200 }
              ];
              updatedSteps[1].status = 'processing';
              return updatedSteps;
            });
          }, 500);

          // 단계 2: 계획
          setTimeout(() => {
            setWorkspaceSteps((prevSteps) => {
              const now = Date.now();
              const updatedSteps = JSON.parse(JSON.stringify(prevSteps));
              updatedSteps[0].status = 'completed';
              updatedSteps[1].status = 'completed';
              updatedSteps[1].agents = [
                { name: 'Orchestrator', status: 'completed', result: '다중 에이전트 워크플로우 수립 완료' },
                { name: 'Task Planner', status: 'completed', result: '4개 에이전트 병렬 작동 계획됨' }
              ];
              updatedSteps[1].agentMessages = [
                { agent: 'Orchestrator', message: '분석 결과 수신 및 전략 수립 시작', timestamp: now },
                { agent: 'Task Planner', message: '작업 분해 및 병렬 처리 최적화 중...', timestamp: now + 150 },
                { agent: 'Orchestrator', message: '4개 에이전트 역할 할당 완료', timestamp: now + 300 },
                { agent: 'Task Planner', message: '워크플로우 의존성 분석 및 일정 수립 완료', timestamp: now + 450 }
              ];
              updatedSteps[2].status = 'processing';
              return updatedSteps;
            });
          }, 1500);

          // Phase 3: 워크플로우 체크포인트 (단계 2-3 사이)
          setTimeout(() => {
            setWorkspaceSteps((prevSteps) => {
              const now2_5 = Date.now();
              const updatedSteps = JSON.parse(JSON.stringify(prevSteps));

              // Decision Checkpoint: 실행 경로 선택
              updatedSteps[1].checkpoints = [
                {
                  id: 'checkpoint-path-selection',
                  stepNumber: 2,
                  type: 'decision',
                  title: '실행 경로 선택',
                  description: '다음 실행 방식을 선택하세요',
                  message: '계획이 완료되었습니다. 어떤 방식으로 실행할지 선택해주세요.',
                  status: 'pending',
                  userApprovalRequired: true,
                  timestamp: now2_5,
                  options: [
                    {
                      id: 'path-conservative',
                      label: '보수적 경로',
                      description: '안전성을 우선시, 느리지만 신뢰성 높음',
                      estimatedTime: 2,
                      estimatedCost: 5,
                      quality: 85,
                      risk: 10,
                      agents: ['validator', 'formatter'],
                      config: { safety: true, thoroughness: 'high' }
                    },
                    {
                      id: 'path-standard',
                      label: '표준 경로',
                      description: '균형잡힌 접근, 시간과 품질 모두 고려',
                      estimatedTime: 5,
                      estimatedCost: 7,
                      quality: 92,
                      risk: 25,
                      agents: ['executor', 'validator', 'formatter'],
                      config: { safety: 'medium', thoroughness: 'standard' }
                    },
                    {
                      id: 'path-aggressive',
                      label: '혁신적 경로',
                      description: '속도 우선, 더 나은 결과를 위한 실험적 접근',
                      estimatedTime: 10,
                      estimatedCost: 9,
                      quality: 98,
                      risk: 45,
                      agents: ['executor', 'analyzer'],
                      config: { safety: false, thoroughness: 'experimental' }
                    }
                  ]
                }
              ];

              return updatedSteps;
            });
          }, 1950);

          // Phase 4: Multi-Agent Orchestration 실행 (단계 2-3 사이)
          setTimeout(async () => {
            try {
              // 에이전트 풀 생성 및 초기화
              const poolConfig: AgentPoolConfig = {
                maxAgents: 4,
                autoScale: false,
                specializations: ['데이터분석', '추론', '검증', '포맷팅'],
                taskTimeout: 10000,
                retryPolicy: { maxRetries: 2, delayMs: 500 },
                loadBalancing: 'round-robin'
              };

              // const poolManager = new AgentPoolManager(poolConfig);
              // poolManager.setStateChangeCallback((state) => {
              //   setAgentPoolState(state);
              // });

              // 병렬 에이전트 생성
              const agents = [
                poolManager.createSpecializedAgent('Data Analyzer', '데이터분석', [
                  'analyze_data',
                  'read_file'
                ]),
                poolManager.createSpecializedAgent('AI Inference', '추론', [
                  'generate_report',
                  'execute_analysis'
                ]),
                poolManager.createSpecializedAgent('Validator', '검증', [
                  'validate_output'
                ]),
                poolManager.createSpecializedAgent('Formatter', '포맷팅', [
                  'format_document'
                ])
              ];

              console.log(`[AGENT_POOL] 🚀 ${agents.length}개 에이전트 생성 완료`);
              setAgentPoolState(poolManager.getPoolState());

              // 병렬 작업 배치 생성
              const tasks: AgentTask[] = [
                {
                  id: 'task-1',
                  agent: 'analyzer',
                  taskType: 'analyze_data',
                  input: { data: userMessage.substring(0, 100) },
                  status: 'pending',
                  timestamp: Date.now()
                },
                {
                  id: 'task-2',
                  agent: 'executor',
                  taskType: 'generate_report',
                  input: { data: userMessage },
                  status: 'pending',
                  timestamp: Date.now()
                },
                {
                  id: 'task-3',
                  agent: 'validator',
                  taskType: 'validate_output',
                  input: { schema: { success: 'boolean', content: 'string' } },
                  status: 'pending',
                  timestamp: Date.now()
                },
                {
                  id: 'task-4',
                  agent: 'formatter',
                  taskType: 'format_document',
                  input: { content: 'formatted output', format: 'markdown' },
                  status: 'pending',
                  timestamp: Date.now()
                }
              ];

              const batch = poolManager.createParallelBatch(tasks);
              console.log(`[AGENT_POOL] 📦 배치 #${batch.batchNumber} 생성 (${tasks.length}개 작업)`);

              // 병렬 배치 실행
              await poolManager.executeBatch(batch, (log) => {
                console.log('[BATCH_EXECUTION]', log);
              });

              const finalState = poolManager.getPoolState();
              setAgentPoolState(finalState);
              console.log(
                `[AGENT_POOL] ✅ 배치 실행 완료 - 성공: ${batch.successCount}, 실패: ${batch.failureCount}`
              );
            } catch (error) {
              console.error('[AGENT_POOL] ❌ 에이전트 풀 실행 오류:', error);
            }
          }, 1800);

          // 단계 3: 실행 - API 호출 (경로 선택 후)
          setTimeout(async () => {
            try {
              const fullApiUrl = `${apiUrl}/agent/query`;

              // 웹 검색 수행
              const searchResult = await performWebSearch(userMessage);
              setSearchSources(searchResult.sources);

              // LARS Agent 수준의 고급 프롬프트 (웹 검색 결과 + 모델 특화 지시사항 포함)
              const modelSpecificInstructions = (() => {
                switch (activeModel) {
                  case 'LARS-Native':
                    return `[모델 최적화: LARS-Native - 고속 실행]
                    - 코드 기반 작업 우선
                    - 간결하고 효율적인 솔루션 제시
                    - 성능 최적화 중심
                    - 직접 실행 가능한 코드 제공`;
                  case 'LARS-Cosmos':
                    return `[모델 최적화: LARS-Cosmos - 깊은 분석]
                    - 복잡한 맥락과 연결고리 고려
                    - 전체적인 아키텍처 관점 제시
                    - 장기적 영향 분석
                    - 다양한 관점 포함`;
                  case 'LARS-Prime':
                    return `[모델 최적화: LARS-Prime - 보안 & 검증]
                    - 보안 취약점 검토
                    - 논리적 결함 지적
                    - 코드 감사 수행
                    - 잠재적 위험 사항 강조`;
                  case 'Aivora':
                    return `[모델 최적화: Aivora - 감정 AI]
                    - 사람의 감정과 심리 분석
                    - 공감적 응답 제공
                    - 감정적 뉘앙스 고려
                    - 심리 상담 관점 포함`;
                  case 'Rekora':
                    return `[모델 최적화: Rekora - 3D 설계]
                    - 시각적 설명 우선
                    - 비주얼 표현 제시
                    - 3D 개념 설명
                    - 디자인 미학 고려`;
                  case 'Synzora':
                    return `[모델 최적화: Synzora - 그래프 분석]
                    - 관계와 네트워크 분석
                    - 데이터 연결고리 시각화
                    - 그래프 구조 제시
                    - 패턴 인식 강조`;
                  case 'Luminaic':
                    return `[모델 최적화: Luminaic - 대규모 분석]
                    - 데이터 기반 분석
                    - 통계적 근거 제시
                    - 대규모 데이터 처리
                    - 정량적 결과 강조`;
                  default:
                    return '';
                }
              })();

              const enhancedQuery = `[LARS WORKSPACE PROTOCOL - 정확성 강화]

당신은 LARS Intelligence Platform의 Workspace 모드 에이전트입니다.
목표: 웹 검색 결과와 고급 추론을 통해 정확하고 신뢰할 수 있는 답변 제공

${modelSpecificInstructions}

[PHASE 1: 질문 분석]
사용자의 질문을 다음 기준으로 분석하세요:
- 핵심 주제: 무엇을 묻고 있는가?
- 정보 타입: 설명/예시/비교/분석/방법 중 어떤 것?
- 시간적 맥락: 최신 정보가 필요한가?

[PHASE 2: 웹 검색 결과 활용 (필수)]
아래 웹 검색 결과를 최우선으로 사용하여 답변하세요.
검색 결과는 가장 신뢰할 수 있는 정보원입니다:
${searchResult.text || '(검색 결과 없음)'}

⚠️ 중요: 검색 결과의 정보를 먼저 사용하고, 자신의 지식은 보충으로만 사용하세요.

[PHASE 3: 답변 구성 (Chain of Thought)]
1. 질문의 핵심을 명확히 파악하기
2. 웹 검색 결과에서 관련 정보 추출하기
3. 정확한 설명과 함께 답변 구성하기
4. 필요시 구체적 예시나 응용 방법 제시하기
5. 신뢰도 평가 및 보충 설명하기

[QUALITY STANDARDS]
✓ 정확성: 질문과 100% 관련된 내용만
✓ 완전성: 필요한 모든 정보 포함
✓ 최신성: 웹 검색 결과 기반 최신 정보
✓ 명확성: 구조화되고 이해하기 쉬운 답변
✓ 신뢰성: 불확실한 부분은 명시

[CRITICAL RULES]
- 사용자의 질문에 정확히 답변하세요
- 질문과 무관한 내용은 절대 포함하지 마세요
- 엉뚱한 주제로 벗어나면 안 됩니다
- 모르는 정보는 명확히 "정확한 정보를 알 수 없습니다" 표시
- 사용자 질문 언어로 답변 (한국어 질문 → 한국어 답변)

[RESPONSE FORMAT]
1. **직접 답변**: 질문에 정확하게 답하는 부분 (1-2문장)
2. **상세 설명**: 이해를 돕는 배경 및 설명
3. **웹 검색 기반**: 최신 정보 및 구체적 예시
4. **추가 정보**: 관련된 유용한 보충 정보 (필요시)

---

[사용자 질문]
"${userMessage}"

위의 LARS WORKSPACE PROTOCOL을 따라 정확하고 신뢰할 수 있는 답변을 제공하세요.`;

              // Workspace 모드에서도 Prism Query API 사용
              const prismApiUrl = `${apiUrl}/agent/prism/query`;

              const agentResponse = await fetch(prismApiUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  query: enhancedQuery,
                  user_id: userId,
                  model: getOllamaModelName(activeModel),
                  use_cache: true
                })
              });

              if (!agentResponse.ok) {
                const errorText = await agentResponse.text();
                fullContent = `❌ 오류: ${errorText}`;
              } else {
                const result = await agentResponse.json();
                const agentResponse_text = result.response || '응답을 생성하지 못했습니다.';

                // 모델 정보와 응답 결합
                if (modelContext) {
                  fullContent = `${modelContext}\n\n---\n\n${agentResponse_text}`;
                } else {
                  fullContent = agentResponse_text;
                }
              }

              // 단계 3: 에이전트 작업 실행
