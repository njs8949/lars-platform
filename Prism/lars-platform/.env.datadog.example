# Docker Compose Datadog Configuration Example
# This file shows what environment variables are needed for docker-compose-datadog.yml
# DO NOT COMMIT actual values

# === REQUIRED ===
# Get from https://app.datadoghq.com/organization/settings/api-keys
DD_API_KEY=your_datadog_api_key_here

# Get from https://app.datadoghq.com/organization/settings/application-keys
DD_APP_KEY=your_datadog_app_key_here

# === DATABASE ===
# Set your actual PostgreSQL password here
DB_PASSWORD=your_postgres_password_here

# === Optional ===
# For EU region: datadoghq.eu
DD_SITE=datadoghq.com

# RDS Instance details (if using RDS monitoring)
RDS_POSTGRES_HOST=your-rds-instance.region.rds.amazonaws.com
RDS_POSTGRES_PORT=5432
RDS_POSTGRES_USER=postgres
RDS_POSTGRES_PASSWORD=your_rds_password_here
RDS_POSTGRES_DBNAME=your_db_name

# === Setup Instructions ===
# 1. Create .env.datadog file in this directory
# 2. Copy values from this example and fill with actual credentials
# 3. Start containers: docker-compose -f docker-compose-datadog.yml --env-file .env.datadog up
# 4. NEVER commit .env.datadog to Git - it's added to .gitignore
