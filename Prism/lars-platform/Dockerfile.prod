# LARS Prism 프로덕션 멀티 스테이지 Dockerfile

# Stage 1: 프론트엔드 빌드
FROM node:24-alpine AS frontend-builder

WORKDIR /app

COPY package*.json ./
RUN rm -f package-lock.json && npm install

COPY . .
RUN npm run build

# Stage 2: 백엔드 빌드
FROM python:3.11-slim AS backend-builder

WORKDIR /app

# 시스템 의존성 설치
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Python 의존성 설치
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Stage 3: 프로덕션 이미지
FROM python:3.11-slim

WORKDIR /app

# 런타임 의존성만 설치
RUN apt-get update && apt-get install -y \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 백엔드 의존성 복사
COPY --from=backend-builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages

# 프론트엔드 빌드 결과 복사
COPY --from=frontend-builder /app/dist ./static
COPY --from=frontend-builder /app/dist /usr/share/nginx/html

# 애플리케이션 코드 복사
COPY . .

# 비루트 사용자 생성
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

# 헬스체크
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/api/health || exit 1

# 포트 노출
EXPOSE 8000

# 환경 변수 설정 (official Datadog Python recommendation)
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PORT=8000 \
    DD_TRACE_ENABLED=true \
    DD_TRACE_SAMPLE_RATE=1 \
    DD_RUNTIME_METRICS_ENABLED=true \
    DD_TRACE_PROPAGATION_STYLE=datadog \
    DD_APPSEC_ENABLED=true \
    DD_APPSEC_SCA_ENABLED=true \
    DD_APPSEC_STACK_TRACE_ENABLED=true \
    DD_INSTRUMENTATION_ENABLED=true \
    DD_IAST_ENABLED=true \
    DD_PROFILING_ENABLED=true \
    DD_PROFILING_INCLUDE_GC=true \
    DD_DBM_PROPAGATION_ENABLED=true \
    DD_DATA_SECURITY_ENABLED=true \
    DD_REMOTE_CONFIGURATION_ENABLED=true \
    DD_SERVICE=lars-prism-auto \
    DD_ENV=production \
    DD_TRACE_DEBUG=false

# 애플리케이션 실행
CMD ["python", "-m", "uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
